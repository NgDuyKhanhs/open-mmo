# ==============================================
# OpenMMO AI Backend Environment Variables
# ==============================================
# Copy this file to .env or set these as system environment variables
# IMPORTANT: Never commit real API keys or secrets!

# ==============================================
# MongoDB Configuration
# ==============================================
MONGODB_URI=mongodb://localhost:27017/openmmo
MONGODB_DATABASE=openmmo

# ==============================================
# JWT Configuration
# ==============================================
# Base64 encoded JWT secret (min 256 bits for HS512)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-256bit-jwt-secret-base64-encoded-here

# Token expiration times (in milliseconds)
JWT_EXPIRATION=86400000          # 24 hours
JWT_REFRESH_EXPIRATION=604800000 # 7 days

# ==============================================
# OAuth2 Google Configuration (Login)
# ==============================================
# Get credentials from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google-callback

# ==============================================
# Gmail OAuth Configuration (Email Automation)
# ==============================================
GMAIL_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/gmail/connect/callback

# ==============================================
# Token Encryption (AES-256)
# ==============================================
# Generate with: openssl rand -base64 32
TOKEN_ENC_KEY_BASE64=your-32-byte-base64-encoded-key-here

# ==============================================
# Gemini API Configuration
# ==============================================
# Get from: https://ai.google.dev/
GEMINI_API_KEY=your-gemini-api-key-here

# ==============================================
# CORS Configuration
# ==============================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
APP_WEB_URL=http://localhost:5173

# ==============================================
# Spring AI Configuration
# ==============================================
# OpenAI API Key (optional)
OPENAI_API_KEY=sk-your-actual-api-key-here

# LLM Model Selection
SPRING_AI_OPENAI_CHAT_MODEL=gpt-4-turbo

# ==============================================
# Server Configuration
# ==============================================
SERVER_PORT=8080

# ==============================================
# Logging Configuration
# ==============================================
LOGGING_LEVEL=INFO
LOGGING_LEVEL_COM_OPENMMO=DEBUG
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_SECURITY=DEBUG
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_DATA_MONGODB=DEBUG

# Database name
SPRING_DATA_MONGODB_DATABASE=openmmo

# Logging levels for Agent Skills
LOGGING_LEVEL_ORG_SPRINGAICOMMUNITY=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_AI=INFO

# File logging (optional)
LOGGING_FILE_NAME=logs/ai-backend.log
LOGGING_FILE_MAX_SIZE=10MB
LOGGING_FILE_MAX_HISTORY=10

# ================================
# Security Configuration
# ================================

# CORS allowed origins (for frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Enable/disable skill execution
AGENT_SKILLS_ENABLED=true

# ================================
# Development Configuration
# ================================

# Enable debug logging
DEBUG=false

# Enable detailed agent execution logs
AGENT_DEBUG_LOGGING=false

# ================================
# Usage Instructions
# ================================
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Fill in your credentials:
#    - Google OAuth: https://console.cloud.google.com/
#    - Gemini API: https://ai.google.dev/
#    - OpenAI (optional): https://platform.openai.com/api-keys
#
# 3. Generate secure keys:
#    - JWT_SECRET: openssl rand -base64 32
#    - TOKEN_ENC_KEY_BASE64: openssl rand -base64 32
#
# 4. Set environment variables:
#    - PowerShell: .\setup-env.ps1
#    - Or manually: $env:VARIABLE_NAME = "value"
#
# 5. Start the application:
#    ./gradlew bootRun
#
# ================================

