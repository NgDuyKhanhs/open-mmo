# ==============================================
# OpenMMO AI Backend Environment Variables
# ==============================================
# Copy this file to .env or set these as system environment variables
# IMPORTANT: Never commit real API keys or secrets!

# ==============================================
# MongoDB Configuration
# ==============================================
MONGODB_URI=mongodb://localhost:27017/openmmo
MONGODB_DATABASE=openmmo

# ==============================================
# JWT Configuration
# ==============================================
# Base64 encoded JWT secret (min 256 bits for HS512)
# Generate with: echo -n "your-secret-key-min-32-chars" | base64
JWT_SECRET=dGhpcyBpcyBhIGxvbmcgand0IHNlY3JldCBrZXkgdGhhdCBzaG91bGQgYmUgYXQgbGVhc3QgMjU2IGJpdHMgZm9yIEhTNTEyIHNpZ25hdHVyZSBhbGdvcml0aG0gYW5kIGluIHByb2R1Y3Rpb24gdXNlIGEgc3Ryb25nIHJhbmRvbSBrZXk=

# Token expiration times (in milliseconds)
JWT_EXPIRATION=86400000          # 24 hours
JWT_REFRESH_EXPIRATION=604800000 # 7 days

# ==============================================
# OAuth2 Google Configuration
# ==============================================
# Get credentials from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=779295627515-28h679li4r6e3mkjn5hspm7g7nqatjre.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-actual-secret-here
GOOGLE_REDIRECT_URI=http://localhost:8081/api/v1/auth/google-callback

# ==============================================
# CORS Configuration
# ==============================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4200

# ==============================================
# Spring AI Configuration
# ==============================================
# OpenAI API Key for LLM capabilities
OPENAI_API_KEY=sk-your-actual-api-key-here

# LLM Model Selection
SPRING_AI_OPENAI_CHAT_MODEL=gpt-4-turbo

# ==============================================
# Server Configuration
# ==============================================
SERVER_PORT=8081

# ==============================================
# Logging Configuration
# ==============================================
LOGGING_LEVEL=INFO
LOGGING_LEVEL_COM_OPENMMO=DEBUG
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_SECURITY=DEBUG
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_DATA_MONGODB=DEBUG


# Database name
SPRING_DATA_MONGODB_DATABASE=openmmo

# ================================
# Logging Configuration
# ================================

# Logging levels for Agent Skills
LOGGING_LEVEL_ORG_SPRINGAICOMMUNITY=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_AI=INFO

# File logging (optional)
LOGGING_FILE_NAME=logs/ai-backend.log
LOGGING_FILE_MAX_SIZE=10MB
LOGGING_FILE_MAX_HISTORY=10

# ================================
# Security Configuration
# ================================

# CORS allowed origins (for frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Enable/disable skill execution
AGENT_SKILLS_ENABLED=true

# Restrict skill execution (production safety)
# AGENT_SKILLS_RESTRICTED_MODE=false

# ================================
# Development Configuration
# ================================

# Enable debug logging
DEBUG=false

# Enable detailed agent execution logs
AGENT_DEBUG_LOGGING=false

# ================================
# Usage Instructions
# ================================
#
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
#
# 2. Fill in your API keys from:
#    - OpenAI: https://platform.openai.com/api-keys
#    - Anthropic: https://console.anthropic.com
#    - Google: https://cloud.google.com/docs/authentication
#
# 3. Start the application:
#    ./gradlew bootRun
#
# 4. Test agent endpoint:
#    curl -X POST http://localhost:8080/api/v1/agent/execute \
#      -H "Content-Type: application/json" \
#      -d '{"task":"Hello, test the skills!"}'
#
# ================================
