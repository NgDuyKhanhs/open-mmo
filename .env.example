# Backend Environment Variables Example
# Copy this file to .env and fill in the actual values
# DO NOT commit .env file to git

# ==============================================
# Spring Profiles
# ==============================================
# Options: local, prod
SPRING_PROFILES_ACTIVE=local

# ==============================================
# API Configuration
# ==============================================
# Backend API URL (used for OAuth redirect URIs)
# Local: http://localhost:8080
# Prod: https://app.openmmo.ai
APP_API_URL=http://localhost:8080

# Frontend URL (for email links and redirects)
# Local: http://localhost:5173
# Prod: https://openmmo.ai
APP_WEB_URL=http://localhost:5173

# ==============================================
# Server Configuration
# ==============================================
SERVER_PORT=8080

# ==============================================
# JWT Configuration
# ==============================================
# Generate a 512-bit Base64 encoded secret using:
# openssl rand -base64 64
JWT_SECRET=your-512-bit-base64-encoded-jwt-secret-here

# ==============================================
# Google OAuth2 Configuration
# ==============================================
# Get credentials from: https://console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# ==============================================
# Gemini API Configuration
# ==============================================
# Get API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ==============================================
# OpenAI Configuration (Optional)
# ==============================================
OPENAI_API_KEY=your-openai-api-key-here

# ==============================================
# MongoDB Configuration
# ==============================================
# Local: mongodb://localhost:27017/openmmo
# Atlas: mongodb+srv://user:password@cluster.mongodb.net/openmmo?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/openmmo
MONGODB_DATABASE=openmmo

# ==============================================
# Gmail Configuration
# ==============================================
GMAIL_API_BASE=https://www.googleapis.com/gmail/v1/users/me

# ==============================================
# CORS Configuration
# ==============================================
# Local: http://localhost:5173,http://localhost:3000
# Prod: https://openmmo.ai,https://www.openmmo.ai,https://app.openmmo.ai
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Whether to allow credentials (cookies/auth headers) in CORS requests
# Set to true in production when explicitly listing origins
# Set to false when using wildcard "*" origins
CORS_ALLOW_CREDENTIALS=false

# ==============================================
# Token Encryption
# ==============================================
# Generate a Base64 encoded encryption key (32 bytes recommended)
# Generate with: openssl rand -base64 32
TOKEN_ENC_KEY_BASE64=your-base64-encoded-token-encryption-key-here

